[Unit]
Description=DotBot native desktop room gateway
After=dotbot-broker.service
Requires=dotbot-broker.service

[Service]
Type=simple
WorkingDirectory=@SOURCE@
ExecStart=@PYTHON@ -B @SOURCE@/dot_gateway.py serve --state-dir @SOURCE@/runtime/dot-private
UMask=0077
UnsetEnvironment=OPENAI_API_KEY CONTROL_PLANE_API_KEY CODEX_APP_TOOLS_PIPE_PATH
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
